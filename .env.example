MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=farm_online_3d
MULTIPLAYER_PORT=8787
# Google Identity Services OAuth 2.0 Web Client ID (same value on both lines).
# Add http://localhost:4177 to Authorized JavaScript origins in Google Cloud.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# World event ID: halloween | none | auto. Add future IDs in server/SeasonConfig.js.
EVENT=halloween

# Production: exact browser origins, comma-separated; empty permits LAN development.
WS_ALLOWED_ORIGINS=
# Connections sharing one IP (raise deliberately for a classroom/LAN).
WS_MAX_CONNECTIONS_PER_IP=32
