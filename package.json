{
  "name": "farm-online-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "start:server": "node server/index.js",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:farm-layout": "node scripts/validate-farm-layout.mjs",
    "test:land": "node scripts/test-land-purchase.mjs",
    "test:camera": "node scripts/test-camera-view.mjs",
    "build": "npm run validate:assets && npm run validate:farm-layout && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@babylonjs/core": "^9.29.0",
    "@babylonjs/loaders": "^9.29.0",
    "mongodb": "^7.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.2.1",
    "vite": "4.5.5"
  }
}
